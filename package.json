{
  "name": "chat",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.conf.json",
    "build": "ng build --source-map",
    "build-all": "rimraf dist && cd server && npm run build && cd .. && npm run build && mv dist/chat/browser dist/public && rimraf dist/chat && cp server/dist/app.js* server/dist/package.json dist/ && [ -f ./userscript-updater.sh ] && ./userscript-updater.sh && cp local_dist/chat-mods.user.js dist/public/chat-mods.user.js && cp -f local_dist/about.html dist/public/assets/about.html",
    "lint": "eslint --ignore-pattern '.angular/' --ignore-pattern '**/tsc-out/' --ignore-pattern '**/dist/'",
    "watch": "ng build --watch --configuration development"
  },
  "private": true,
  "packageManager": "npm@10.9.2",
  "dependencies": {
    "@angular/common": "^21.2.6",
    "@angular/compiler": "^21.2.6",
    "@angular/core": "^21.2.6",
    "@angular/forms": "^21.2.6",
    "@angular/platform-browser": "^21.2.6",
    "@angular/router": "^21.2.6",
    "@ctrl/ngx-emoji-mart": "^9.3.0",
    "@fortawesome/fontawesome-free": "^7.2.0",
    "@primeng/themes": "^21.0.4",
    "@tubular/util": "^4.19.0",
    "ngx-quill": "^30.0.1",
    "primeflex": "^4.0.0",
    "primeicons": "^7.0.0",
    "primeng": "^21.1.5",
    "quill": "2.0.2 || ^2.0.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.5",
    "@angular/cli": "^21.2.5",
    "@angular/compiler-cli": "^21.2.6",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "eslint": "^10.1.0",
    "eslint-plugin-chai-friendly": "^1.1.1",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "rimraf": "^6.1.3",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
